{
  "name": "olive",
  "version": "1.6.4",
  "description": "Olive: microphone manager for Windows. Windows mic volume/mute, noise gate, noise reduction, EQ, compressor, send to Discord",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node tools/build-helper.js && vite build",
    "start": "electron .",
    "build:ui": "vite build",
    "preview": "vite build && node tools/preview.js",
    "test:gate-live": "node tools/audio-test/live-gate.js",
    "build": "node tools/build.js",
    "patch-exe": "node tools/patch-exe.js",
    "make-icons": "node tools/make-icons.js",
    "make-sounds": "node tools/make-sounds.js",
    "installer": "node tools/make-installer.js",
    "test:installer": "node tools/installer/test.js",
    "test:audio": "node tools/audio-test/run.js",
    "update-runtime": "node tools/update-runtime.js"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^2.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^7.3.8"
  }
}
