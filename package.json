{
  "name": "mic-manager",
  "version": "1.4.0",
  "description": "Microphone manager for Windows: Windows mic volume/mute, noise gate, noise reduction, EQ, compressor, send to Discord",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node tools/build-helper.js",
    "start": "electron .",
    "build": "node tools/build.js",
    "patch-exe": "node tools/patch-exe.js",
    "test:audio": "node tools/audio-test/run.js",
    "update-runtime": "node tools/update-runtime.js"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "resedit": "^2.0.0"
  }
}
